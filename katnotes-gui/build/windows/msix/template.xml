<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="katnotes-gui"
        Arguments=""
        InstallLocation="C:\Program Files\devinthemtn\KatNotes">
    </Installer>
    <PackageInformation
        PackageName="KatNotes"
        PackageDisplayName="KatNotes"
        PublisherName="CN=devinthemtn"
        PublisherDisplayName="devinthemtn"
        Version="0.10.0.0"
        PackageDescription="Personal Markdown notes">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.devinthemtn.katnotes"
                Description="Personal Markdown notes"
                DisplayName="KatNotes"
                ExecutableName="katnotes-gui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>KatNotes</DisplayName>
            <PublisherDisplayName>devinthemtn</PublisherDisplayName>
            <Description>Personal Markdown notes</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="katnotes-gui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
